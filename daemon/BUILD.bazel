# lhd: the lighthouse tracking daemon (transport → protocol → kernel → JSON
# lines). See src/main.rs.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "lhd",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//device:lh_device",
        "//kernel:lh_kernel",
        "//protocol:lh_protocol",
        "//transport:lh_transport",
        "@lh_host_crates//:flate2",
        "@lh_host_crates//:serde_json",
    ],
)

# The same over the f32 kernel: replays a recording the way the ESP32-P4 would
# track it, for comparing against lhd.
rust_binary(
    name = "lhd_f32",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//device:lh_device_f32",
        "//kernel:lh_kernel_f32",
        "//protocol:lh_protocol_f32",
        "//transport:lh_transport",
        "@lh_host_crates//:flate2",
        "@lh_host_crates//:serde_json",
    ],
)

# lhd's unit tests (CLI parsing, calibration store): no device needed.
rust_test(
    name = "lhd_test",
    crate = ":lhd",
)
